{
  // Dashboard (static assets) plus a cron-trigger script that starts the GitHub recorder workflow.
  // The Worker name must match the Worker created in the Cloudflare dashboard ("dollar").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dollar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dashboard", "binding": "ASSETS" },
  "observability": { "enabled": true },   // keep Worker logs so failed dispatches are visible in the dashboard
  "routes": [{ "pattern": "dollar.elskatemm.com", "custom_domain": true }],
  // UTC. Weekday names (not numbers) because Cloudflare's day-of-week numbering differs from Unix cron. First: poll every 5 minutes through the US session (the recorder skips anything not 'Open'). Second: rebuild reports.
  "triggers": { "crons": ["*/5 13-21 * * MON-FRI", "40 21 * * MON-FRI"] }
}
